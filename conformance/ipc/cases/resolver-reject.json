{
  "schema_version": 1,
  "id": "resolver.reject",
  "targets": ["resolver"],
  "timeout_ms": 10000,
  "actions": [
    {"kind": "initialize", "manifest": "inline", "profile": "default"},
    {"kind": "resolve", "name": "FORGE_TOKEN", "expect": "first"},
    {"kind": "rotate_upstream", "value": "second"},
    {"kind": "resolve", "name": "FORGE_TOKEN", "expect": "first"},
    {"kind": "reject", "name": "FORGE_TOKEN", "invalidated": true},
    {"kind": "reject", "name": "FORGE_TOKEN", "invalidated": false},
    {"kind": "reject", "name": "NOT_DECLARED", "invalidated": false},
    {"kind": "resolve", "name": "FORGE_TOKEN", "expect": "second"},
    {"kind": "disconnect"}
  ],
  "required_events": [
    "initialized",
    "stale_value_served",
    "cache_invalidated",
    "idempotent_reject",
    "undeclared_reject",
    "fresh_value_served",
    "closed"
  ]
}

{
  "schema_version": 1,
  "id": "wire.strict-rejections",
  "targets": ["common"],
  "timeout_ms": 5000,
  "actions": [
    {"kind": "raw_frame", "payload_hex": ""},
    {"kind": "raw_frame", "payload_hex": "ff"},
    {"kind": "raw_frame", "prefix_hex": "0000"},
    {"kind": "raw_frame", "declared_length": 10, "payload_hex": "7b7d"},
    {"kind": "raw_frame", "payload_utf8": "[]"},
    {"kind": "raw_frame", "payload_utf8": "{\"jsonrpc\":\"2.0\",\"jsonrpc\":\"2.0\"}"},
    {"kind": "raw_frame", "payload_utf8": "{\"jsonrpc\":\"2.0\",\"id\":999,\"result\":{}}"}
  ],
  "required_events": ["rejected", "closed"]
}

<script>
  (() => {
    const demo = document.querySelector<HTMLElement>('[data-reference-demo]');
    if (!demo) return;
    const demoEl = demo;

    const states = ['variable', 'pointer', 'resolved'];
    const targets = demoEl.querySelectorAll<HTMLElement>('[data-reference-target]');
    const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let isPinned = false;
    let timer: number | undefined;

    function setReferenceState(state: string) {
      const nextIndex = states.indexOf(state);
      if (nextIndex === -1) return;
      activeIndex = nextIndex;
      demoEl.setAttribute('data-active-reference', state);
    }

    function stop() {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    }

    function start() {
      if (reducedMotion || timer !== undefined) return;
      timer = window.setInterval(() => {
        if (isPinned) return;
        setReferenceState(states[(activeIndex + 1) % states.length]);
      }, 2600);
    }

    targets.forEach((target) => {
      const state = target.getAttribute('data-reference-target');
      if (!state) return;

      target.addEventListener('pointerenter', () => {
        isPinned = true;
        setReferenceState(state);
      });
      target.addEventListener('pointerleave', () => {
        isPinned = false;
      });
      target.addEventListener('focus', () => {
        isPinned = true;
        setReferenceState(state);
      });
      target.addEventListener('blur', () => {
        isPinned = false;
      });
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            start();
          } else {
            stop();
          }
        });
      }, { threshold: 0.2 });
      observer.observe(demoEl);
    } else {
      start();
    }
  })();
</script>


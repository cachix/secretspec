---
import Default from '@astrojs/starlight/components/Hero.astro';

const normalizedBase = import.meta.env.BASE_URL.replace(/\/+$/, '');
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '');
const isLandingRoute = normalizedPath === '' || normalizedPath === normalizedBase;
---
{isLandingRoute ? null : <Default {...Astro.props}><slot /></Default>}

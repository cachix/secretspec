cabal-version:      2.4
name:               monosecret
version:            0.2.1
synopsis:           Haskell SDK for Monosecret, a declarative secrets manager
description:
  A thin client over the @monosecret_ffi@ C ABI (linked at build time).
  Resolution (providers, chains, profiles, generation, @as_path@) happens in the
  Rust core; this package marshals a JSON request to the native library and
  parses the response, mirroring the Rust derive crate's vocabulary.
homepage:           https://ifiokjr.github.io/monosecret/
license:            Apache-2.0
license-file:       LICENSE
author:             Ifiok Jr.
maintainer:         ifiokotung@gmail.com
category:           Configuration
build-type:         Simple

flag use-pkg-config
  description:
    Locate monosecret_ffi and its link dependencies through pkg-config
    (monosecret_ffi.pc) instead of command-line library and linker paths.
  default:            False
  manual:             True

library
  exposed-modules:    Monosecret
  hs-source-dirs:     src
  build-depends:      base       >=4.14 && <5
                    , aeson      >=2.0  && <3
                    , bytestring <1
                    , containers <1
                    , directory  <2
                    , setenv     <1
                    , text       <3
  -- The native resolver is linked at build time. The default path below uses
  -- the static archive; pkg-config may select a static or shared install.
  --
  -- Without the flag: point --extra-lib-dirs at a directory containing ONLY
  -- libmonosecret_ffi.a (so -lmonosecret_ffi resolves to the archive, not a
  -- co-located .so), and pass the archive's transitive native deps via
  -- --ghc-options=-optl<lib> (capture them with
  -- `cargo rustc -p monosecret_ffi --crate-type staticlib -- --print native-static-libs`).
  if flag(use-pkg-config)
    pkgconfig-depends: monosecret_ffi
  else
    extra-libraries:  monosecret_ffi
  -- The Darwin frameworks among the archive's native dependencies, declared
  -- so every final link (executable, test-suite, ghci) receives them through
  -- the compiler driver.
  if os(darwin)
    frameworks:       SystemConfiguration Security CoreFoundation
  default-language:   Haskell2010
  ghc-options:        -Wall

executable monosecret-quick-start-example
  main-is:            QuickStart.hs
  hs-source-dirs:     examples
  build-depends:      base
                    , containers
                    , monosecret
  default-language:   Haskell2010
  ghc-options:        -Wall

executable monosecret-scopes-example
  main-is:            Scopes.hs
  hs-source-dirs:     examples
  build-depends:      base
                    , monosecret
  default-language:   Haskell2010
  ghc-options:        -Wall

executable monosecret-report-example
  main-is:            Report.hs
  hs-source-dirs:     examples
  build-depends:      base
                    , monosecret
  default-language:   Haskell2010
  ghc-options:        -Wall

test-suite monosecret-test
  type:               exitcode-stdio-1.0
  main-is:            Main.hs
  hs-source-dirs:     test
  build-depends:      base
                    , monosecret
                    , aeson      >=2.0
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , process
                    , text
  default-language:   Haskell2010
  ghc-options:        -Wall -threaded

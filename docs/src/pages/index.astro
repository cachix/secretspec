<script>
  (() => {
    const demo = document.querySelector<HTMLElement>('[data-profiles-demo]');
    if (!demo) return;
    const demoEl = demo;

    const profiles = ['development', 'production'];
    const targets = demoEl.querySelectorAll<HTMLElement>('[data-profile-target]');
    const commandValue = demoEl.querySelector<HTMLElement>('[data-profile-command-value]');
    const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let isPinned = false;
    let timer: number | undefined;

    function setProfile(profile: string) {
      const nextIndex = profiles.indexOf(profile);
      if (nextIndex === -1) return;
      activeIndex = nextIndex;
      demoEl.setAttribute('data-active-profile', profile);
      if (commandValue) {
        commandValue.textContent = profile;
      }
    }

    function stop() {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    }

    function start() {
      if (reducedMotion || timer !== undefined) return;
      timer = window.setInterval(() => {
        if (isPinned) return;
        setProfile(profiles[(activeIndex + 1) % profiles.length]);
      }, 2600);
    }

    targets.forEach((target) => {
      const profile = target.getAttribute('data-profile-target');
      if (!profile) return;

      target.addEventListener('pointerenter', () => {
        isPinned = true;
        setProfile(profile);
      });
      target.addEventListener('pointerleave', () => {
        isPinned = false;
      });
      target.addEventListener('focus', () => {
        isPinned = true;
        setProfile(profile);
      });
      target.addEventListener('blur', () => {
        isPinned = false;
      });
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            start();
          } else {
            stop();
          }
        });
      }, { threshold: 0.2 });
      observer.observe(demoEl);
    } else {
      start();
    }
  })();
</script>


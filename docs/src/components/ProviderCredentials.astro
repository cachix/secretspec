---
import credentialCatalog from '../data/provider-credentials.json';

interface Credential {
	name: string;
	environmentFallbacks: string[];
	since: string;
}

interface ProviderCredentialEntry {
	provider: string;
	implementationSources: string[];
	credentials: Credential[];
}

interface Props {
	provider?: string;
}

const { provider } = Astro.props;
const catalog = credentialCatalog as ProviderCredentialEntry[];
const entries = provider
	? catalog.filter((entry) => entry.provider === provider)
	: catalog;

if (provider && entries.length !== 1) {
	throw new Error(`Unknown provider credential catalog entry: ${provider}`);
}
---

<table>
	<thead>
		<tr>
			{!provider && <th>Provider</th>}
			<th>Credential</th>
			<th>Environment fallback</th>
			<th>Available since</th>
		</tr>
	</thead>
	<tbody>
		{
			entries.map((entry) =>
				entry.credentials.map((credential) => (
					<tr>
						{!provider && (
							<td>
								<a href={`/providers/${entry.provider}/`}><code>{entry.provider}</code></a>
							</td>
						)}
						<td><code>{credential.name}</code></td>
						<td>
							{credential.environmentFallbacks.length === 0
								? '—'
								: credential.environmentFallbacks.map((name, index) => (
									<>
										{index > 0 && ' → '}
										<code>{name}</code>
									</>
								))}
						</td>
						<td>{credential.since}+</td>
					</tr>
				)),
			)
		}
	</tbody>
</table>

{
	provider && (
		<p>
			See the complete <a href="/reference/provider-credentials/">provider credential reference</a> for
			all supported providers and environment fallbacks.
		</p>
	)
}

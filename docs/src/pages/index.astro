<script is:inline define:vars={{ reelData: reelScriptData }}>
  (function () {
    const providerReel = document.querySelector('[data-reel="providers"]');
    const consumerReel = document.querySelector('[data-reel="consumers"]');
    const terminalBody = document.querySelector('[data-pipeline-terminal-body]');

    if (!providerReel || !consumerReel || !terminalBody) return;

    document.querySelectorAll('[data-reel-icon-img]').forEach((img) => {
      function markMissing() {
        const item = img.closest('.landing-reel-item');
        if (item) item.classList.add('is-icon-missing');
      }

      img.addEventListener('error', markMissing, { once: true });
      if (img.complete && img.naturalWidth === 0) markMissing();
    });

    const SLOT_H = 76;
    const SLOT_W_MOBILE = 216;
    const MOBILE_QUERY = window.matchMedia('(max-width: 900px)');
    const AUTO_TICK_MS = 2600;
    const AUTO_ANIM_MS = 760;
    const SNAP_ANIM_MS = 320;
    const RESUME_AFTER_MS = 4200;
    const DRAG_THRESHOLD_PX = 5;
    const INERTIA_MIN_VELOCITY = 0.00075;
    const INERTIA_FRICTION = 0.000055;
    const INERTIA_MAX_VELOCITY = 0.05;
    const AUTO_EPOCH = performance.now();

    function esc(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[c]));
    }

    function codeLine(html, index) {
      return '<span class="landing-code-line" style="--line:' + index + '">' + html + '</span>';
    }

    function updateTerminal(consumer) {
      const maxLen = Math.max.apply(null, consumer.secrets.map((s) => s.length));
      const rows = consumer.secrets.map((name, index) => {
        const pad = ' '.repeat(Math.max(1, maxLen - name.length + 1));
        const row =
          '<span class="tok-key">' + esc(name) + '</span>' + pad +
          '<span class="tok-pun">= {</span> ' +
          '<span class="tok-key">required</span> ' +
          '<span class="tok-pun">=</span> ' +
          '<span class="tok-bool">true</span> ' +
          '<span class="tok-pun">}</span>';
        return codeLine(row, index + 5);
      }).join('');

      terminalBody.innerHTML = [
        codeLine('<span class="tok-sec">[project]</span>', 0),
        codeLine('<span class="tok-key">name</span> <span class="tok-pun">=</span> <span class="tok-str">"my-app"</span>', 1),
        codeLine('<span class="tok-key">revision</span> <span class="tok-pun">=</span> <span class="tok-str">"1.0"</span>', 2),
        codeLine('&nbsp;', 3),
        codeLine('<span class="tok-sec">[profiles.default]</span>', 4),
        rows,
      ].join('');
    }

    function makeReel(opts) {
      const { reelEl, itemCount, direction, onActiveChange, phase } = opts;
      const trackEl = reelEl.querySelector('.landing-reel-track');
      let scroll = itemCount;
      let currentActive = -1;
      let rafId = null;
      let autoTimerId = null;
      let autoStartId = null;
      let resumeTimerId = null;
      let dragState = null;
      let suppressNextClick = false;

      function applyScroll() {
        const min = itemCount * 0.5;
        const max = itemCount * 2.5;
        while (scroll < min) scroll += itemCount;
        while (scroll > max) scroll -= itemCount;
        trackEl.style.setProperty('--scroll', String(scroll));

        const rounded = Math.round(scroll);
        const active = ((rounded % itemCount) + itemCount) % itemCount;
        if (active !== currentActive) {
          currentActive = active;
          if (onActiveChange) onActiveChange(active);
        }
      }

      function stopAnim() {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = null;
      }

      function startInertia(initialVelocity) {
        stopAnim();
        let velocity = Math.max(-INERTIA_MAX_VELOCITY, Math.min(INERTIA_MAX_VELOCITY, initialVelocity));
        let lastTime = performance.now();

        if (Math.abs(velocity) < INERTIA_MIN_VELOCITY) {
          snapToNearest();
          return;
        }

        const step = (now) => {
          const dt = Math.min(48, now - lastTime);
          lastTime = now;
          scroll += velocity * dt;
          applyScroll();

          const drag = INERTIA_FRICTION * dt;
          if (velocity > 0) {
            velocity = Math.max(0, velocity - drag);
          } else {
            velocity = Math.min(0, velocity + drag);
          }

          if (Math.abs(velocity) >= INERTIA_MIN_VELOCITY) {
            rafId = requestAnimationFrame(step);
          } else {
            rafId = null;
            snapToNearest(420);
          }
        };

        rafId = requestAnimationFrame(step);
      }

      function animateTo(target, duration) {
        stopAnim();
        const start = scroll;
        const startTime = performance.now();
        const step = (now) => {
          const t = Math.min(1, (now - startTime) / duration);
          const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
          scroll = start + (target - start) * e;
          applyScroll();
          if (t < 1) {
            rafId = requestAnimationFrame(step);
          } else {
            rafId = null;
          }
        };
        rafId = requestAnimationFrame(step);
      }

      function snapToNearest(duration) {
        const target = Math.round(scroll);
        if (Math.abs(target - scroll) < 0.001) return;
        animateTo(target, duration || SNAP_ANIM_MS);
      }

      function autoTick() {
        const base = Math.round(scroll);
        const target = direction === 'up' ? base + 1 : base - 1;
        animateTo(target, AUTO_ANIM_MS);
      }

      function startAuto() {
        if (autoTimerId || autoStartId) return;
        const elapsed = performance.now() - AUTO_EPOCH;
        const cyclePos = ((elapsed - (phase || 0)) % AUTO_TICK_MS + AUTO_TICK_MS) % AUTO_TICK_MS;
        const delay = (AUTO_TICK_MS - cyclePos) % AUTO_TICK_MS;
        autoStartId = setTimeout(function () {
          autoStartId = null;
          autoTick();
          autoTimerId = setInterval(autoTick, AUTO_TICK_MS);
        }, delay);
      }
      function stopAuto() {
        if (autoTimerId) { clearInterval(autoTimerId); autoTimerId = null; }
        if (autoStartId) { clearTimeout(autoStartId); autoStartId = null; }
      }
      function scheduleResume() {
        clearTimeout(resumeTimerId);
        resumeTimerId = setTimeout(startAuto, RESUME_AFTER_MS);
      }

      function onPointerDown(e) {
        if (e.button !== undefined && e.button !== 0) return;
        stopAuto();
        stopAnim();
        clearTimeout(resumeTimerId);
        dragState = {
          startX: e.clientX,
          startY: e.clientY,
          startScroll: scroll,
          moved: false,
          pointerId: e.pointerId,
          lastPos: MOBILE_QUERY.matches ? e.clientX : e.clientY,
          lastTime: performance.now(),
          velocity: 0,
        };
        try { reelEl.setPointerCapture(e.pointerId); } catch (_) {}
        reelEl.classList.add('is-dragging');
      }
      function onPointerMove(e) {
        if (!dragState) return;
        const horizontal = MOBILE_QUERY.matches;
        const now = performance.now();
        const pos = horizontal ? e.clientX : e.clientY;
        const dt = Math.max(1, now - dragState.lastTime);
        const slotSize = horizontal ? SLOT_W_MOBILE : SLOT_H;
        const instantVelocity = -((pos - dragState.lastPos) / slotSize) / dt;
        dragState.velocity = dragState.velocity * 0.25 + instantVelocity * 0.75;
        dragState.lastPos = pos;
        dragState.lastTime = now;

        const d = horizontal ? (e.clientX - dragState.startX) : (e.clientY - dragState.startY);
        if (Math.abs(d) > DRAG_THRESHOLD_PX) dragState.moved = true;
        scroll = dragState.startScroll - d / slotSize;
        applyScroll();
      }
      function onPointerUp(e) {
        if (!dragState) return;
        try { reelEl.releasePointerCapture(dragState.pointerId); } catch (_) {}
        const moved = dragState.moved;
        const staleMs = performance.now() - dragState.lastTime;
        const releaseVelocity = staleMs > 80 ? dragState.velocity * 0.35 : dragState.velocity;
        dragState = null;
        reelEl.classList.remove('is-dragging');

        if (moved) {
          startInertia(releaseVelocity);
          suppressNextClick = true;
        } else {
          const hit = document.elementFromPoint(e.clientX, e.clientY);
          const slot = hit && hit.closest && hit.closest('.landing-reel-slot');
          const idx = slot ? Number(slot.dataset.index) : NaN;
          if (Number.isFinite(idx) && idx !== Math.round(scroll)) {
            stopAuto();
            clearTimeout(resumeTimerId);
            animateTo(idx, SNAP_ANIM_MS);
            suppressNextClick = true;
          }
        }
        scheduleResume();
      }
      function onPointerCancel() {
        if (!dragState) return;
        try { reelEl.releasePointerCapture(dragState.pointerId); } catch (_) {}
        dragState = null;
        reelEl.classList.remove('is-dragging');
        snapToNearest();
        scheduleResume();
      }
      function onClickCapture(e) {
        if (suppressNextClick) {
          e.preventDefault();
          e.stopPropagation();
          suppressNextClick = false;
        }
      }

      reelEl.addEventListener('pointerdown', onPointerDown);
      reelEl.addEventListener('pointermove', onPointerMove);
      reelEl.addEventListener('pointerup', onPointerUp);
      reelEl.addEventListener('pointercancel', onPointerCancel);
      reelEl.addEventListener('click', onClickCapture, true);
      reelEl.addEventListener('dragstart', (e) => e.preventDefault());

      let hovering = false;
      reelEl.addEventListener('mouseenter', () => {
        hovering = true;
        stopAuto();
      });
      reelEl.addEventListener('mouseleave', () => {
        hovering = false;
        scheduleResume();
      });
      reelEl.addEventListener('focusin', () => {
        stopAuto();
      });
      reelEl.addEventListener('focusout', () => {
        scheduleResume();
      });

      applyScroll();

      return {
        start: () => { if (!hovering && !dragState) startAuto(); },
        stop: () => { stopAuto(); stopAnim(); },
      };
    }

    const providerCtl = makeReel({
      reelEl: providerReel,
      itemCount: reelData.providerCount,
      direction: providerReel.dataset.direction || 'down',
    });

    const consumerCtl = makeReel({
      reelEl: consumerReel,
      itemCount: reelData.consumerCount,
      direction: consumerReel.dataset.direction || 'up',
      onActiveChange: (idx) => {
        const consumer = reelData.consumers[idx];
        updateTerminal(consumer);
      },
      phase: AUTO_TICK_MS / 2,
    });

    const section = document.querySelector('.landing-hero');
    if (section && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            providerCtl.start();
            consumerCtl.start();
          } else {
            providerCtl.stop();
            consumerCtl.stop();
          }
        });
      }, { threshold: 0.15 });
      io.observe(section);
    } else {
      providerCtl.start();
      consumerCtl.start();
    }

    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      providerCtl.stop();
      consumerCtl.stop();
    }
  })();
</script>


---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import sopsLogo from '../assets/sops-logo.svg';
import { syntaxColorCss, syntaxColorHex, type SyntaxColorName } from '../data/syntax-colors';

const docs = await getCollection('docs');

// Latest blog post, surfaced in a banner near the top of the landing page.
const posts = docs
  .filter((e) => e.id.startsWith('blog/') && !e.data.draft)
  .sort(
    (a, b) =>
      (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0),
  );

const latestPost = posts[0];
const providerCount = docs.filter((e) => e.id.startsWith('providers/')).length;
const sdkCount = docs.filter(
  (e) => e.id.startsWith('sdk/') && e.id !== 'sdk/overview',
).length;

const latestPostDate = latestPost?.data.date
  ? new Intl.DateTimeFormat('en', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(latestPost.data.date)
  : null;

type ProviderMetadata = {
  /** One of:
   * - simpleicons CDN icon name
   * - object specifying image source and type
   * - if not provided renders the generic lock icon as fallback
   */
  icon?: string | { src: typeof sopsLogo; type: 'bundled'};
  label: string;
  slug: string
};

const providerMetadata: ProviderMetadata[] = [
  { icon: 'apple', slug: 'keyring', label: 'macOS Keychain' },
  { slug: 'kdbx', label: 'KeePass KDBX (0.17+)' },
  { icon: '1password', slug: 'onepassword', label: '1Password' },
  { slug: 'keeper', label: 'Keeper Secrets Manager (0.18+)' },
  { icon: 'lastpass', slug: 'lastpass', label: 'LastPass' },
  { slug: 'dashlane', label: 'Dashlane (0.18+)' },
  { icon: 'bitwarden', slug: 'bw', label: 'Bitwarden Password Manager (0.18+)' },
  { icon: 'vault', slug: 'vault', label: 'Vault' },
  { slug: 'openbao', label: 'OpenBao (0.17+)' },
  { slug: 'awssm', label: 'AWS Secrets Manager' },
  { slug: 'awsps', label: 'AWS Parameter Store (0.18+)' },
  { slug: 'scaleway', label: 'Scaleway Secret Manager (0.17+)' },
  { icon: 'googlecloud', slug: 'gcsm', label: 'Google Cloud Secret Manager' },
  { icon: 'microsoftazure', slug: 'akv', label: 'Azure Key Vault' },
  { slug: 'infisical', label: 'Infisical' },
  { slug: 'age', label: 'age (0.17+)' },
  { slug: 'gopass', label: 'Gopass' },
  { slug: 'protonpass', label: 'Proton Pass' },
  { icon: 'gnuprivacyguard', slug: 'pass', label: 'Pass (GPG)' },
  { icon: 'dotenv', slug: 'dotenv', label: '.env files' },
  { slug: 'env', label: 'Environment variables' },
  { icon: 'systemd', slug: 'systemd-credential', label: 'systemd credentials (0.17+)' },
  { icon: 'bitwarden', slug: 'bws', label: 'Bitwarden Secrets Manager' },
  { icon: 'linux', slug: 'keyring', label: 'Secret Service' },
  { slug: 'keyring', label: 'Credential Manager' },
  { icon: { src: sopsLogo, type: 'bundled' }, slug: 'sops', label: 'SOPS (0.17+)' },
];

type ConsumerMetadata = {
  icon?: string;
  label: string;
  href: string;
  secrets: string[];
};

const consumerMetadata: ConsumerMetadata[] = [
  { icon: 'rust', label: 'Rust', href: '/sdk/rust/',
    secrets: ['DATABASE_URL', 'API_TOKEN', 'HMAC_SECRET'] },
  { icon: 'python', label: 'Python', href: '/sdk/python/',
    secrets: ['DATABASE_URL', 'SECRET_KEY', 'REDIS_URL'] },
  { icon: 'django', label: 'Django', href: '/sdk/python/',
    secrets: ['DJANGO_SECRET_KEY', 'DATABASE_URL', 'EMAIL_HOST_PASSWORD'] },
  { icon: 'fastapi', label: 'FastAPI', href: '/sdk/python/',
    secrets: ['DATABASE_URL', 'JWT_SECRET', 'OPENAI_API_KEY'] },
  { icon: 'nodedotjs', label: 'Node.js', href: '/sdk/nodejs/',
    secrets: ['DATABASE_URL', 'SESSION_SECRET', 'STRIPE_SECRET_KEY'] },
  { icon: 'nextdotjs', label: 'Next.js', href: '/sdk/nodejs/',
    secrets: ['AUTH_SECRET', 'DATABASE_URL', 'STRIPE_SECRET_KEY'] },
  { icon: 'express', label: 'Express', href: '/sdk/nodejs/',
    secrets: ['DATABASE_URL', 'SESSION_SECRET', 'JWT_SECRET'] },
  { icon: 'go', label: 'Go', href: '/sdk/go/',
    secrets: ['DATABASE_URL', 'API_KEY', 'REDIS_URL'] },
  { icon: 'ruby', label: 'Ruby', href: '/sdk/ruby/',
    secrets: ['DATABASE_URL', 'SECRET_KEY_BASE', 'REDIS_URL'] },
  { icon: 'rubyonrails', label: 'Rails', href: '/sdk/ruby/',
    secrets: ['SECRET_KEY_BASE', 'DATABASE_URL', 'RAILS_MASTER_KEY'] },
  { icon: 'php', label: 'PHP', href: '/sdk/php/',
    secrets: ['DATABASE_URL', 'APP_KEY', 'MAIL_PASSWORD'] },
  { icon: 'laravel', label: 'Laravel', href: '/sdk/php/',
    secrets: ['APP_KEY', 'DB_PASSWORD', 'PUSHER_APP_SECRET'] },
  { icon: 'symfony', label: 'Symfony', href: '/sdk/php/',
    secrets: ['APP_SECRET', 'DATABASE_URL', 'MAILER_DSN'] },
  { icon: 'dotnet', label: '.NET / C#', href: '/sdk/csharp/',
    secrets: ['CONNECTIONSTRINGS__DEFAULT', 'JWT__SECRET', 'API_KEY'] },
  { icon: 'haskell', label: 'Haskell', href: '/sdk/haskell/',
    secrets: ['DATABASE_URL', 'API_KEY', 'SIGNING_KEY'] },
  { icon: 'swift', label: 'Swift (0.18+)', href: '/sdk/swift/',
    secrets: ['DATABASE_URL', 'API_KEY', 'SENTRY_DSN'] },
  { icon: 'githubactions', label: 'GitHub Actions', href: '/ci/github-actions/',
    secrets: ['NPM_TOKEN', 'AWS_SECRET_ACCESS_KEY', 'CODECOV_TOKEN'] },
  { label: 'Forgejo Actions', href: '/ci/github-actions/',
    secrets: ['NPM_TOKEN', 'FORGEJO_TOKEN', 'DEPLOY_KEY'] },
  { icon: 'nixos', label: 'devenv & Nix', href: 'https://devenv.sh/integrations/secretspec/',
    secrets: ['DATABASE_URL', 'CACHIX_AUTH_TOKEN', 'REDIS_URL'] },
  { icon: 'systemd', label: 'systemd', href: '/providers/systemd-credential/',
    secrets: ['TLS_CERT', 'DB_PASSWORD', 'SERVICE_TOKEN'] },
  { icon: 'docker', label: 'Docker', href: '/reference/cli/#export',
    secrets: ['POSTGRES_PASSWORD', 'REDIS_URL', 'REGISTRY_AUTH'] },
  { icon: 'kubernetes', label: 'Kubernetes', href: '/reference/cli/#export',
    secrets: ['DATABASE_URL', 'TLS_CERT', 'HELM_REGISTRY_TOKEN'] },
];

const providerLoop = [...providerMetadata, ...providerMetadata, ...providerMetadata];
const consumerLoop = [...consumerMetadata, ...consumerMetadata, ...consumerMetadata];

const providerColors: Record<string, SyntaxColorName> = {
  keyring: 'blue',
  kdbx: 'yellow',
  onepassword: 'red',
  keeper: 'yellow',
  lastpass: 'red',
  dashlane: 'cyan',
  bw: 'red',
  bws: 'cyan',
  vault: 'blue',
  openbao: 'cyan',
  awssm: 'orange',
  awsps: 'orange',
  scaleway: 'magenta',
  gcsm: 'red',
  akv: 'blue',
  infisical: 'cyan',
  age: 'yellow',
  gopass: 'green',
  protonpass: 'magenta',
  pass: 'yellow',
  dotenv: 'green',
  env: 'comment',
  'systemd-credential': 'blue',
  sops: 'magenta',
};

const consumerColors: Record<string, SyntaxColorName> = {
  Rust: 'red',
  Python: 'yellow',
  Django: 'green',
  FastAPI: 'cyan',
  'Node.js': 'green',
  'Next.js': 'comment',
  Express: 'comment',
  Go: 'cyan',
  Ruby: 'red',
  Rails: 'red',
  PHP: 'magenta',
  Laravel: 'red',
  Symfony: 'comment',
  '.NET / C#': 'blue',
  Haskell: 'magenta',
  'Swift (0.18+)': 'red',
  'GitHub Actions': 'comment',
  'Forgejo Actions': 'orange',
  'devenv & Nix': 'cyan',
  systemd: 'blue',
  Docker: 'cyan',
  Kubernetes: 'blue',
};

function providerTone(provider: ProviderMetadata) {
  return syntaxColorHex[providerColors[provider.slug] ?? 'blue'];
}

function consumerTone(consumer: ConsumerMetadata) {
  return syntaxColorHex[consumerColors[consumer.label] ?? 'blue'];
}

const isReelDuplicate = (index: number, itemCount: number) =>
  index < itemCount || index >= itemCount * 2;

const reelScriptData = {
  providerLabels: providerMetadata.map((p) => p.label),
  consumers: consumerMetadata.map((c) => ({ label: c.label, secrets: c.secrets })),
  providerCount: providerMetadata.length,
  consumerCount: consumerMetadata.length,
};
---

<StarlightPage
  frontmatter={{
    title: 'A declarative interface for every secret provider.',
    description: `Replace shared .env files with a manifest of what your application expects. Keep values out of git and resolve them from any of ${providerCount} providers.`,
    template: 'splash',
    hero: { tagline: '' },
  }}
  hasSidebar={false}
>
<style is:inline set:html={syntaxColorCss}></style>
<div class="not-content">

<!-- ============ HERO ============ -->
<section class="landing-hero">
  <div class="landing-hero-inner">
    <!-- Latest blog post. It sits inside the hero so the grid backdrop shows through. -->
    {latestPost && (
    <a href={`/blog/${latestPost.id.replace(/^blog\//, '')}/`} class="landing-blog-banner">
      <span class="landing-blog-aside">
        <span class="landing-blog-flag">Latest from the blog</span>
        {latestPostDate && <span class="landing-blog-date">{latestPostDate}</span>}
      </span>
      <span class="landing-blog-main">
        <span class="landing-blog-title">{latestPost.data.title}</span>
        {latestPost.data.description && (
          <span class="landing-blog-desc">{latestPost.data.description}</span>
        )}
      </span>
      <span class="landing-blog-cta" aria-hidden="true">Read post →</span>
    </a>
    )}

    <div class="landing-hero-head landing-hero-head-interface">
      <h1 id="_top" class="landing-hero-title">A declarative interface<br>for every secret provider.</h1>
      <p class="landing-hero-subtitle">
        Stop leaking <code class="inline-code">.env</code> files. Commit what your application expects in <code class="inline-code">secretspec.toml</code>, never the values.<br class="landing-wide-break"> Developers, CI, and production can each resolve the same declaration from any of {providerCount} providers.
      </p>
    </div>

    <div class="landing-pipeline-grid">

    <div class="landing-pipeline-side">
      <div class="landing-pipeline-action landing-pipeline-action-left">
        <a href="/concepts/providers/" class="landing-btn landing-btn-secondary landing-btn-flow">Providers ({providerCount})</a>
      </div>
      <div class="landing-reel" data-reel="providers" data-direction="down"
           data-item-count={providerMetadata.length}
           aria-label="Scrollable list of secret providers">
        <div class="landing-reel-track" style={`--scroll:${providerMetadata.length}`}>
          {providerLoop.map((p, i) => (
            <a
              href={`/providers/${p.slug}`}
              class="landing-reel-slot"
              data-index={i}
              style={`--i:${i};--reel-color:#${providerTone(p)}`}
              draggable="false"
              aria-hidden={isReelDuplicate(i, providerMetadata.length) ? 'true' : undefined}
              tabindex={isReelDuplicate(i, providerMetadata.length) ? -1 : undefined}
            >
              <div class="landing-reel-slot-inner">
                <div class="landing-reel-item">
                  {typeof p.icon === 'string' ? (
                    <>
                      <img data-reel-icon-img class="landing-reel-icon" src={`https://cdn.simpleicons.org/${p.icon}/${providerTone(p)}`} alt="" width="20" height="20" loading="lazy" />
                      <svg class="landing-reel-icon landing-reel-icon-fallback" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </>
                  ) : typeof p.icon === 'object' && p.icon.type === 'bundled' ? (
                    <img class="landing-reel-icon" src={p.icon.src.src} alt="" width="20" height="20" loading="lazy" />
                  ) : (
                    <svg class="landing-reel-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  )}
                  <span>{p.label}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="landing-pipeline-center">
      <div class="landing-terminal landing-pipeline-terminal" data-pipeline-terminal>
        <div class="landing-terminal-header">
          <div class="landing-terminal-dots"><span></span><span></span><span></span></div>
          <span class="landing-terminal-title">secretspec.toml</span>
        </div>
        <pre is:raw class="landing-terminal-body"><code data-pipeline-terminal-body><span class="tok-sec">[project]</span>
<span class="tok-key">name</span> <span class="tok-pun">=</span> <span class="tok-str">"my-app"</span>
<span class="tok-key">revision</span> <span class="tok-pun">=</span> <span class="tok-str">"1.0"</span>

<span class="tok-sec">[profiles.default]</span>
<span class="tok-key">DATABASE_URL</span>      <span class="tok-pun">= {</span> <span class="tok-key">required</span> <span class="tok-pun">=</span> <span class="tok-num">true</span> <span class="tok-pun">}</span>
<span class="tok-key">API_TOKEN</span>         <span class="tok-pun">= {</span> <span class="tok-key">required</span> <span class="tok-pun">=</span> <span class="tok-num">true</span> <span class="tok-pun">}</span>
<span class="tok-key">HMAC_SECRET</span>       <span class="tok-pun">= {</span> <span class="tok-key">required</span> <span class="tok-pun">=</span> <span class="tok-num">true</span> <span class="tok-pun">}</span></code></pre>
      </div>
      <p class="landing-pipeline-resolve">
        <span class="landing-pipeline-resolve-label">Resolving from</span>
        <span class="landing-pipeline-resolve-provider" data-pipeline-resolving>{providerMetadata[0].label}</span>
      </p>
    </div>

    <div class="landing-pipeline-side">
      <div class="landing-pipeline-action landing-pipeline-action-right">
        <a href="/sdk/overview/" class="landing-btn landing-btn-secondary landing-btn-flow">SDKs ({sdkCount})</a>
      </div>
      <div class="landing-reel" data-reel="consumers" data-direction="up"
           data-item-count={consumerMetadata.length}
           aria-label="Scrollable list of SDKs and integrations">
        <div class="landing-reel-track" style={`--scroll:${consumerMetadata.length}`}>
          {consumerLoop.map((c, i) => (
            <a
              href={c.href}
              class="landing-reel-slot"
              data-index={i}
              style={`--i:${i};--reel-color:#${consumerTone(c)}`}
              draggable="false"
              aria-hidden={isReelDuplicate(i, consumerMetadata.length) ? 'true' : undefined}
              tabindex={isReelDuplicate(i, consumerMetadata.length) ? -1 : undefined}
            >
              <div class="landing-reel-slot-inner">
                <div class="landing-reel-item">
                  {c.icon ? (
                    <>
                      <img data-reel-icon-img class="landing-reel-icon" src={`https://cdn.simpleicons.org/${c.icon}/${consumerTone(c)}`} alt="" width="20" height="20" loading="lazy" />
                      <svg class="landing-reel-icon landing-reel-icon-fallback" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </>
                  ) : (
                    <svg class="landing-reel-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  )}
                  <span>{c.label}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    </div>

    <div class="landing-hero-lower-actions">
      <a href="/quick-start/" class="landing-btn landing-btn-primary">Get Started</a>
      <a href="/concepts/overview/" class="landing-btn landing-btn-secondary">Concepts</a>
    </div>
  </div>
</section>

<!-- ============ DECLARATIVE INTRO ============ -->
<section class="landing-section landing-declarative-section">
  <div class="landing-container">
    <div class="landing-section-centered">
      <h2 class="landing-section-title">Set up SecretSpec in three steps.</h2>
      <p class="landing-section-lead landing-section-lead-narrow">
        Create a shared contract for the secrets your application needs, choose a provider for the values, and run.
      </p>
    </div>

    <div class="landing-hero-split landing-declarative-split">
      <!-- Left: secretspec.toml preview -->
      <div class="landing-hero-preview">
        <div class="landing-terminal">
          <div class="landing-terminal-header">
            <div class="landing-terminal-dots"><span></span><span></span><span></span></div>
            <span class="landing-terminal-title">secretspec.toml</span>
          </div>
          <pre is:raw class="landing-terminal-body"><code><span class="tok-sec">[project]</span>
<span class="tok-key">name</span> <span class="tok-pun">=</span> <span class="tok-str">"my-app"</span>
<span class="tok-key">revision</span> <span class="tok-pun">=</span> <span class="tok-str">"1.0"</span>

<span class="tok-sec">[profiles.default]</span>
<span class="tok-key">DATABASE_URL</span> <span class="tok-pun">= {</span> <span class="tok-key">description</span> <span class="tok-pun">=</span> <span class="tok-str">"PostgreSQL"</span><span class="tok-pun">,</span> <span class="tok-key">required</span> <span class="tok-pun">=</span> <span class="tok-num">true</span> <span class="tok-pun">}</span>
<span class="tok-key">REDIS_URL</span>    <span class="tok-pun">= {</span> <span class="tok-key">description</span> <span class="tok-pun">=</span> <span class="tok-str">"Redis cache"</span> <span class="tok-pun">}</span>
<span class="tok-key">TLS_CERT</span>     <span class="tok-pun">= {</span> <span class="tok-key">as_path</span> <span class="tok-pun">=</span> <span class="tok-num">true</span> <span class="tok-pun">}</span>
<span class="tok-key">DB_PASSWORD</span>  <span class="tok-pun">= {</span> <span class="tok-key">type</span> <span class="tok-pun">=</span> <span class="tok-str">"password"</span><span class="tok-pun">,</span> <span class="tok-key">generate</span> <span class="tok-pun">=</span> <span class="tok-num">true</span> <span class="tok-pun">}</span>

<span class="tok-sec">[profiles.development]</span>
<span class="tok-com"># Inherits from default; override what changes</span>
<span class="tok-key">DATABASE_URL</span> <span class="tok-pun">= {</span> <span class="tok-key">default</span> <span class="tok-pun">=</span> <span class="tok-str">"postgresql://localhost/dev"</span> <span class="tok-pun">}</span></code></pre>
        </div>
      </div>

      <!-- Right: runtime/terminal -->
      <div class="landing-hero-preview">
        <div class="landing-terminal landing-terminal-run">
          <div class="landing-terminal-header">
            <div class="landing-terminal-dots"><span></span><span></span><span></span></div>
            <span class="landing-terminal-title">terminal</span>
          </div>
<pre is:raw class="landing-terminal-body"><code><span class="landing-run-step"><span class="tok-com"># 1. Initialize from existing .env</span>
<span class="landing-prompt">$</span> <span class="landing-cmd"><span class="tok-bin">secretspec</span> <span class="landing-arg">init</span> <span class="landing-flag">--from</span> <span class="landing-arg">dotenv</span></span>
<span class="landing-ok">✓</span> Created secretspec.toml with 5 secrets</span>

<span class="landing-run-step is-provider-list"><span class="tok-com"># 2. Pick a user-global default (0.17+)</span>
<span class="landing-prompt">$</span> <span class="landing-cmd"><span class="tok-bin">secretspec</span> <span class="landing-arg">config global init</span></span>
? Select your preferred provider backend:
<span class="landing-provider-cursor" aria-hidden="true">›</span><a class="landing-provider-line is-selected" href="/providers/keyring/"><span class="provider-name">keyring</span>: Uses system keychain (Recommended)</a>
<span class="landing-provider-slot" aria-hidden="true"> </span><a class="landing-provider-line" href="/providers/bw/"><span class="provider-name">bw</span>: Bitwarden Password Manager (0.18+)</a>
<span class="landing-provider-slot" aria-hidden="true"> </span><a class="landing-provider-line" href="/providers/kdbx/"><span class="provider-name">kdbx</span>: KeePass KDBX databases (0.17+)</a>
<span class="landing-provider-slot" aria-hidden="true"> </span><a class="landing-provider-line" href="/providers/keeper/"><span class="provider-name">keeper</span>: Keeper Secrets Manager (0.18+) via official Rust SDK</a>
<span class="landing-provider-slot" aria-hidden="true"> </span><a class="landing-provider-line" href="/providers/infisical/"><span class="provider-name">infisical</span>: Infisical secret management</a>
<span class="landing-provider-slot" aria-hidden="true"> </span><a class="landing-provider-line" href="/providers/openbao/"><span class="provider-name">openbao</span>: OpenBao secret management (0.17+)</a>
<span class="landing-provider-slot" aria-hidden="true"> </span><a class="landing-provider-line" href="/providers/age/"><span class="provider-name">age</span>: age-encrypted file (0.17+)</a>
<span class="landing-provider-slot" aria-hidden="true"> </span><a class="landing-provider-line" href="/providers/sops/"><span class="provider-name">sops</span>: SOPS encrypted files (0.17+)</a>
<span class="landing-provider-slot" aria-hidden="true"> </span><a class="landing-provider-line" href="/providers/systemd-credential/"><span class="provider-name">systemd-credential</span>: Read-only systemd service credentials (0.17+)</a>
<span class="landing-provider-slot" aria-hidden="true"> </span><a class="landing-provider-line" href="/providers/awsps/"><span class="provider-name">awsps</span>: AWS Systems Manager Parameter Store (0.18+)</a>
<span class="landing-provider-slot" aria-hidden="true"> </span><a class="landing-provider-line" href="/providers/scaleway/"><span class="provider-name">scaleway</span>: Scaleway Secret Manager (0.17+)</a>
<span class="landing-provider-slot" aria-hidden="true"> </span><a class="landing-provider-line" href="/providers/dashlane/"><span class="provider-name">dashlane</span>: Dashlane password manager, read-only (0.18+)</a>
<span class="landing-ok">✓</span> Saved to ~/.config/secretspec/config.toml</span>

<span class="landing-run-step"><span class="tok-com"># 3. Run your app with secrets injected</span>
<span class="landing-prompt">$</span> <span class="landing-cmd"><span class="tok-bin">secretspec</span> <span class="landing-arg">run</span> <span class="landing-flag">--profile</span> <span class="landing-arg">production</span> <span class="landing-flag">--</span> <span class="tok-bin">npm</span> <span class="landing-arg">start</span></span>
<span class="landing-ok">✓</span> Loaded DATABASE_URL from keyring

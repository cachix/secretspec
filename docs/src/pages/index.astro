<script>
  (function () {
    const providerList = document.querySelector<HTMLElement>('.landing-run-step.is-provider-list');
    const cursor = providerList?.querySelector<HTMLElement>('.landing-provider-cursor');
    const lines = Array.from(providerList?.querySelectorAll<HTMLElement>('.landing-provider-line') ?? []);
    const firstLine = lines[0];

    if (!providerList || !cursor || !firstLine) return;

    const providerListEl = providerList;
    const cursorEl = cursor;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const selectionDelay = 1500;

    function greatestCommonDivisor(left: number, right: number): number {
      while (right !== 0) {
        const next = left % right;
        left = right;
        right = next;
      }

      return left;
    }

    function coprimeStep(total: number): number {
      for (let candidate = Math.max(1, Math.floor(total / 2)); candidate > 1; candidate -= 1) {
        if (greatestCommonDivisor(candidate, total) === 1) return candidate;
      }

      return 1;
    }

    const selectionStep = coprimeStep(lines.length);
    const selectionOrder = lines.map(function (_, index) {
      return (index * selectionStep) % lines.length;
    });

    let nextOrderIndex = 1;
    let autoSelectTimer: number | undefined;

    function lineOffset(line: HTMLElement) {
      return line.getBoundingClientRect().top - firstLine.getBoundingClientRect().top;
    }

    function selectLine(line: HTMLElement) {
      lines.forEach(function (line) {
        line.classList.remove('is-selected');
      });
      line.classList.add('is-selected');
      cursorEl.style.setProperty(
        '--landing-provider-cursor-transform',
        `translate(0.28rem, ${lineOffset(line)}px)`
      );
      providerListEl.style.setProperty(
        '--run-selected',
        line.style.getPropertyValue('--provider-line-color') || 'var(--syntax-blue)'
      );
    }

    function stopAutoSelect() {
      if (autoSelectTimer !== undefined) {
        window.clearInterval(autoSelectTimer);
        autoSelectTimer = undefined;
      }
    }

    function selectNextLine() {
      const nextLineIndex = selectionOrder[nextOrderIndex];
      nextOrderIndex = (nextOrderIndex + 1) % selectionOrder.length;
      const nextLine = lines[nextLineIndex];

      if (nextLine) selectLine(nextLine);
    }

    function startAutoSelect() {
      stopAutoSelect();
      if (reduceMotion.matches) return;
      autoSelectTimer = window.setInterval(selectNextLine, selectionDelay);
    }

    function resumeAutoSelect(line: HTMLElement) {
      if (line.matches(':hover') || document.activeElement === line) return;
      startAutoSelect();
    }

    function selectInteractiveLine(line: HTMLElement) {
      const lineIndex = lines.indexOf(line);

      if (lineIndex !== -1) {
        const orderIndex = selectionOrder.indexOf(lineIndex);
        nextOrderIndex = orderIndex === -1 ? 0 : (orderIndex + 1) % selectionOrder.length;
      }

      stopAutoSelect();
      selectLine(line);
    }

    lines.forEach(function (line) {
      line.addEventListener('pointerenter', function () { selectInteractiveLine(line); });
      line.addEventListener('pointerleave', function () { resumeAutoSelect(line); });
      line.addEventListener('focus', function () { selectInteractiveLine(line); });
      line.addEventListener('blur', function () { resumeAutoSelect(line); });
    });

    selectLine(firstLine);
    startAutoSelect();

    reduceMotion.addEventListener('change', function () {
      if (reduceMotion.matches) {
        stopAutoSelect();
      } else {
        startAutoSelect();
      }
    });
  })();
</script>


      });
      panels.forEach((panel) => {
        panel.setAttribute('aria-hidden', String(panel.getAttribute('data-sdk-panel') !== id));
      });
      const activePanel = panels.find((panel) => panel.getAttribute('data-sdk-panel') === id);
      if (activePanel) {
        activePanel.classList.remove('is-popping');
        void activePanel.offsetWidth;
        activePanel.classList.add('is-popping');
      }
    }

    function stop() {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    }

    function start() {
      if (reducedMotion || timer !== undefined) return;
      timer = window.setInterval(() => {
        if (isPinned || !sdkIds.length) return;
        setSdk(sdkIds[(activeIndex + 1) % sdkIds.length]);
      }, 2400);
    }

    targets.forEach((target) => {
      const id = target.getAttribute('data-sdk-target');
      if (!id) return;
      const sdkId = id;

      function pin() {
        isPinned = true;
        setSdk(sdkId);
      }

      target.addEventListener('pointerenter', pin);
      target.addEventListener('click', pin);
      target.addEventListener('pointerleave', () => {
        isPinned = false;
      });
      target.addEventListener('focus', pin);
      target.addEventListener('blur', () => {
        isPinned = false;
      });
    });

    if (feature) {
      feature.addEventListener('pointerenter', () => {
        isPinned = true;
      });
      feature.addEventListener('pointerleave', () => {
        isPinned = false;
      });
      feature.addEventListener('focusin', () => {
        isPinned = true;
      });
      feature.addEventListener('focusout', () => {
        isPinned = false;
      });
    }

    setSdk(sdkIds[0] ?? '');

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            start();
          } else {
            stop();
          }
        });
      }, { threshold: 0.2 });
      observer.observe(demoEl);
    } else {
      start();
    }
  })();
</script>


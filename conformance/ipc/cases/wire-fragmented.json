{
  "schema_version": 1,
  "id": "wire.fragmented-frame",
  "targets": ["common"],
  "timeout_ms": 5000,
  "actions": [
    {"kind": "launch", "protocol": "secretspec.client"},
    {"kind": "peer_write", "chunks": [1, 1, 1, 1, 2, 3, 5]},
    {"kind": "shutdown"}
  ],
  "required_events": ["initialized", "frame_accepted", "closed"]
}

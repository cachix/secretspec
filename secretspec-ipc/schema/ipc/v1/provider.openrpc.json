      "params": [{ "name": "params", "required": true, "schema": { "$ref": "provider.schema.json#/$defs/AddressParams" } }],
      "result": { "name": "result", "schema": { "$ref": "provider.schema.json#/$defs/ResolveAddressResult" } }

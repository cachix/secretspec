<script>
  (function () {
    document.querySelectorAll<HTMLElement>('[data-flow-demo]').forEach((demoEl) => {
      const kind = demoEl.dataset.flowDemo;
      const mapEl = demoEl.querySelector<HTMLElement>('[data-remote-map]')!;
      const statusEl = demoEl.querySelector<HTMLElement>('[data-remote-status]')!;
      const statusDotEl = demoEl.querySelector<HTMLElement>('.landing-remote-status-dot')!;
      const motionButtonEl = demoEl.querySelector<HTMLButtonElement>('[data-remote-motion]')!;
      const timerEl = demoEl.querySelector<HTMLElement>('[data-remote-timer]');
      const timerValueEl = demoEl.querySelector<HTMLElement>('[data-remote-timer-value]');
      const timerLabelEl = demoEl.querySelector<HTMLElement>('[data-remote-timer-label]');
      const packets = Array.from(demoEl.querySelectorAll<HTMLElement>('[data-remote-packet]'));

      if (!kind || !mapEl || !statusEl || !statusDotEl || !motionButtonEl || packets.length === 0) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nodes = new Map<string, HTMLElement>();
      const routes = new Map<string, SVGPathElement>();
      const routeBases = new Map<string, SVGPathElement>();
      const codeTokens = Array.from(demoEl.querySelectorAll<HTMLElement>('.landing-remote-config-token'));
      const routePoints = new Map<string, Array<{ x: number; y: number }>>();
      const animations = new Set<Animation>();
      let timerFrame: number | undefined;
      let timerResolve: ((completed: boolean) => void) | undefined;
      let cycleId = 0;
      let running = false;
      let inView = false;
      let userPaused = false;

      demoEl.querySelectorAll<HTMLElement>('[data-remote-node]').forEach((node) => {
        const name = node.dataset.remoteNode;
        if (name) nodes.set(name, node);
      });
      demoEl.querySelectorAll<SVGPathElement>('[data-remote-route]').forEach((route) => {
        const name = route.dataset.remoteRoute;
        if (name) routes.set(name, route);
      });
      demoEl.querySelectorAll<SVGPathElement>('[data-remote-route-base]').forEach((route) => {
        const name = route.dataset.remoteRouteBase;
        if (name) routeBases.set(name, route);
      });

      const routeEnds: Record<string, [string, string]> = kind === 'cache'
        ? {
            'app-core': ['core', 'app'],
            'core-azure': ['azure', 'core'],
            'core-cache': ['core', 'cache'],
          }
        : {
            'bootstrap-onepassword': ['bootstrap', 'onepassword'],
            'onepassword-core': ['onepassword', 'core'],
            'core-app': ['core', 'app'],
          };

      function port(name: string, side: 'left' | 'right' | 'top' | 'bottom') {
      const node = nodes.get(name);
      if (!node) return { x: 0, y: 0 };
      const nodeRect = node.getBoundingClientRect();
      const mapRect = mapEl.getBoundingClientRect();
      const centerX = nodeRect.left - mapRect.left + nodeRect.width / 2;
      const centerY = nodeRect.top - mapRect.top + nodeRect.height / 2;
      if (side === 'left') return { x: nodeRect.left - mapRect.left, y: centerY };
      if (side === 'right') return { x: nodeRect.right - mapRect.left, y: centerY };
      if (side === 'top') return { x: centerX, y: nodeRect.top - mapRect.top };
      return { x: centerX, y: nodeRect.bottom - mapRect.top };
      }

      function drawRoutes() {
        const compact = window.matchMedia('(max-width: 820px)').matches;
        const definitions: Record<string, Array<{ x: number; y: number }>> = kind === 'cache'
          ? {
              'app-core': compact
                ? [port('core', 'left'), port('app', 'right')]
                : [port('core', 'right'), port('app', 'left')],
              'core-azure': compact
                ? [port('azure', 'top'), port('core', 'bottom')]
                : [port('azure', 'right'), port('core', 'left')],
              'core-cache': compact
                ? [port('core', 'bottom'), port('cache', 'top')]
                : [port('core', 'right'), port('cache', 'left')],
            }
          : {
              'bootstrap-onepassword': [port('bootstrap', 'right'), port('onepassword', 'left')],
              'onepassword-core': compact
                ? [port('onepassword', 'bottom'), port('core', 'top')]
                : [port('onepassword', 'right'), port('core', 'left')],
              'core-app': [port('core', 'right'), port('app', 'left')],
            };

      Object.entries(definitions).forEach(([name, points]) => {
        routePoints.set(name, points);
        const path = points.map((point, index) => `${index ? 'L' : 'M'} ${point.x} ${point.y}`).join(' ');
        routes.get(name)?.setAttribute('d', path);
        routeBases.get(name)?.setAttribute('d', path);
      });
      }

      function setStatus(message: string, color: string) {
      statusEl.textContent = message;
      statusDotEl.style.backgroundColor = color;
      statusDotEl.style.boxShadow = `0 0 0 0.25rem color-mix(in srgb, ${color} 12%, transparent)`;
      }

      function setActive(nodeNames: string[], routeNames?: string | string[], color?: string) {
        nodes.forEach((node) => node.classList.remove('is-active'));
        routes.forEach((route) => route.classList.remove('is-active'));
        codeTokens.forEach((token) => token.classList.remove('is-active'));
        nodeNames.forEach((name) => nodes.get(name)?.classList.add('is-active'));
        codeTokens.forEach((token) => {
          token.classList.toggle('is-active', nodeNames.some((name) => token.classList.contains(`is-${name}`)));
        });
        const activeRoutes = typeof routeNames === 'string' ? [routeNames] : routeNames ?? [];
        activeRoutes.forEach((routeName) => {
          const route = routes.get(routeName);
          route?.classList.add('is-active');
          if (color) route?.style.setProperty('--remote-path-color', color);
        });
      }

      function setFresh(fresh: boolean) {
        mapEl.classList.toggle('is-cache-fresh', fresh);
        nodes.get('azure')?.classList.toggle('is-dimmed', fresh);
        nodes.get('cache')?.classList.toggle('is-dimmed', !fresh);
      }

      function updateTimer(hours: number, progress: number, label = 'fresh') {
        if (!timerEl || !timerValueEl || !timerLabelEl) return;
      const displayHours = Math.max(0, Math.ceil(hours));
      timerEl.style.setProperty('--remote-progress', `${Math.max(0, progress) * 360}deg`);
      timerValueEl.textContent = `${displayHours}h`;
      timerLabelEl.textContent = label;
      timerEl.setAttribute('aria-label', `Cache freshness: ${displayHours} hours remaining`);
      }

      function resetTimer() {
        if (!timerEl || !timerValueEl || !timerLabelEl) return;
      timerEl.style.setProperty('--remote-progress', '0deg');
      timerValueEl.textContent = '—';
      timerLabelEl.textContent = 'empty';
      timerEl.setAttribute('aria-label', 'Cache freshness: empty');
      }

      function delay(milliseconds: number, id: number) {
      return new Promise<boolean>((resolve) => {
        window.setTimeout(() => resolve(running && id === cycleId), milliseconds);
      });
      }

      async function travel(options: {
      route: string;
      from: string;
      via?: Array<{ route: string; from: string }>;
      label: string;
      color: string;
      packet: number;
      duration?: number;
      id: number;
    }) {
      if (!running || options.id !== cycleId) return false;
      drawRoutes();
      const points: Array<{ x: number; y: number }> = [];
      const legs = [{ route: options.route, from: options.from }, ...(options.via ?? [])];
      legs.forEach((leg) => {
        const legPoints = [...(routePoints.get(leg.route) ?? [])];
        const ends = routeEnds[leg.route];
        if (!ends || ends[0] !== leg.from) legPoints.reverse();
        points.push(...legPoints);
      });
      if (points.length < 2) return false;

      const packet = packets[options.packet];
      packet.textContent = options.label;
      packet.style.setProperty('--remote-packet-color', options.color);
      packet.style.opacity = '0';
      const firstPoint = points[0];
      const lastPoint = points[points.length - 1];
      const secondPoint = points[1];
      const penultimatePoint = points[points.length - 2];
      const startDelta = { x: secondPoint.x - firstPoint.x, y: secondPoint.y - firstPoint.y };
      const endDelta = { x: lastPoint.x - penultimatePoint.x, y: lastPoint.y - penultimatePoint.y };
      const startDistance = Math.hypot(startDelta.x, startDelta.y);
      const endDistance = Math.hypot(endDelta.x, endDelta.y);
      const startHorizontal = Math.abs(startDelta.x) >= Math.abs(startDelta.y);
      const endHorizontal = Math.abs(endDelta.x) >= Math.abs(endDelta.y);
      const startClearance = Math.min((startHorizontal ? packet.offsetWidth : packet.offsetHeight) / 2 + 8, startDistance * 0.2);
      const endClearance = Math.min((endHorizontal ? packet.offsetWidth : packet.offsetHeight) / 2 + 8, endDistance * 0.2);
      points[0] = {
        x: firstPoint.x + (startDistance ? startDelta.x / startDistance : 0) * startClearance,
        y: firstPoint.y + (startDistance ? startDelta.y / startDistance : 0) * startClearance,
      };
      points[points.length - 1] = {
        x: lastPoint.x - (endDistance ? endDelta.x / endDistance : 0) * endClearance,
        y: lastPoint.y - (endDistance ? endDelta.y / endDistance : 0) * endClearance,
      };
      const transform = (point: { x: number; y: number }) => `translate(${point.x}px, ${point.y}px) translate(-50%, -50%)`;
      const first = points[0];
      const last = points[points.length - 1];
      const distances = [0];
      for (let index = 1; index < points.length; index += 1) {
        distances.push(distances[index - 1] + Math.hypot(points[index].x - points[index - 1].x, points[index].y - points[index - 1].y));
      }
      const totalDistance = distances[distances.length - 1] || 1;
      const pathFrames = points.slice(1, -1).map((point, index) => ({
        transform: transform(point),
        opacity: 1,
        offset: 0.08 + (distances[index + 1] / totalDistance) * 0.84,
      }));
      const animation = packet.animate([
        { transform: transform(first), opacity: 0 },
        { transform: transform(first), opacity: 1, offset: 0.08 },
        ...pathFrames,
        { transform: transform(last), opacity: 1, offset: 0.92 },
        { transform: transform(last), opacity: 0 },
      ], {
        duration: options.duration ?? 820,
        easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
      });
      animations.add(animation);
      try {
        await animation.finished;
      } catch {
        return false;
      } finally {
        animations.delete(animation);
      }
      return running && options.id === cycleId;
      }

      function startTimer(id: number, duration: number) {
      const startedAt = performance.now();
      return new Promise<boolean>((resolve) => {
        timerResolve = resolve;
        function frame(now: number) {
          if (!running || id !== cycleId) {
            timerResolve = undefined;
            resolve(false);
            return;
          }
          const elapsed = Math.min(1, (now - startedAt) / duration);
          updateTimer(8 * (1 - elapsed), 1 - elapsed);
          if (elapsed >= 1) {
            timerFrame = undefined;
            timerResolve = undefined;
            resolve(true);
            return;
          }
          timerFrame = window.requestAnimationFrame(frame);
        }
        timerFrame = window.requestAnimationFrame(frame);
      });
      }

      async function firstRead(id: number) {
      setFresh(false);
      resetTimer();
      setStatus('Your App asks cached_azure for DATABASE_URL', 'var(--remote-app)');
      setActive(['app', 'core'], 'app-core', 'var(--remote-app)');
      if (!await travel({ route: 'app-core', from: 'app', label: 'DATABASE_URL?', color: 'var(--remote-app)', packet: 0, id })) return false;
      if (!await delay(260, id)) return false;

      setStatus('cached_azure fetches DATABASE_URL from azure', 'var(--remote-azure)');
      setActive(['core', 'azure'], 'core-azure', 'var(--remote-azure)');
      if (!await travel({ route: 'core-azure', from: 'core', label: 'DATABASE_URL?', color: 'var(--remote-azure)', packet: 0, duration: 760, id })) return false;
      if (!await delay(180, id)) return false;

      setStatus('azure returns DATABASE_URL to cached_azure', 'var(--remote-azure)');
      setActive(['azure', 'core'], 'core-azure', 'var(--remote-azure)');
      if (!await travel({ route: 'core-azure', from: 'azure', label: 'DATABASE_URL', color: 'var(--remote-azure)', packet: 0, duration: 940, id })) return false;
      if (!await delay(220, id)) return false;

      setStatus('cached_azure sends DATABASE_URL to Your App and local_cache', 'var(--remote-cache)');
      nodes.forEach((node) => node.classList.remove('is-active'));
      routes.forEach((route) => route.classList.remove('is-active'));
      nodes.get('core')?.classList.add('is-active');
      nodes.get('app')?.classList.add('is-active');
      nodes.get('cache')?.classList.add('is-active');
      codeTokens.forEach((token) => token.classList.toggle('is-active', token.classList.contains('is-core') || token.classList.contains('is-cache')));
      routes.get('app-core')?.classList.add('is-active');
      routes.get('core-cache')?.classList.add('is-active');
      routes.get('app-core')?.style.setProperty('--remote-path-color', 'var(--remote-app)');
      routes.get('core-cache')?.style.setProperty('--remote-path-color', 'var(--remote-cache)');
      nodes.get('core')?.classList.add('is-splitting');
      const delivered = await Promise.all([
        travel({ route: 'app-core', from: 'core', label: 'DATABASE_URL', color: 'var(--remote-app)', packet: 0, duration: 980, id }),
        travel({ route: 'core-cache', from: 'core', label: 'DATABASE_URL', color: 'var(--remote-cache)', packet: 1, duration: 980, id }),
      ]);
      nodes.get('core')?.classList.remove('is-splitting');
      if (!delivered.every(Boolean)) return false;
      setFresh(true);
      updateTimer(8, 1);
      return true;
    }

      async function cachedRead(id: number) {
      setStatus('Your App requests DATABASE_URL from local_cache', 'var(--remote-app)');
      setActive(['app', 'core', 'cache'], ['app-core', 'core-cache'], 'var(--remote-app)');
      if (!await travel({
        route: 'app-core',
        from: 'app',
        via: [{ route: 'core-cache', from: 'core' }],
        label: 'DATABASE_URL?',
        color: 'var(--remote-app)',
        packet: 0,
        duration: 560,
        id,
      })) return false;

      setStatus('local_cache returns DATABASE_URL to Your App', 'var(--remote-cache)');
      setActive(['cache', 'core', 'app'], ['core-cache', 'app-core'], 'var(--remote-cache)');
      if (!await travel({
        route: 'core-cache',
        from: 'cache',
        via: [{ route: 'app-core', from: 'core' }],
        label: 'DATABASE_URL',
        color: 'var(--remote-cache)',
        packet: 0,
        duration: 680,
        id,
      })) return false;
      nodes.forEach((node) => node.classList.remove('is-active'));
      routes.forEach((route) => route.classList.remove('is-active'));
      codeTokens.forEach((token) => token.classList.remove('is-active'));
      return true;
    }

      async function runCacheLoop(id: number) {
      while (running && id === cycleId) {
        if (!await firstRead(id)) return;
        setStatus('local_cache is fresh · azure rests for 8h', 'var(--remote-cache)');
        const countdown = startTimer(id, 8200);

        if (!await delay(700, id) || !await cachedRead(id)) return;
        if (!await delay(900, id) || !await cachedRead(id)) return;
        if (!await delay(900, id) || !await cachedRead(id)) return;
        if (!await countdown) return;

        setFresh(false);
        updateTimer(0, 0, 'expired');
        setStatus('local_cache expired · azure is active again', 'var(--remote-azure)');
        setActive(['azure']);
        if (!await delay(900, id)) return;
      }
      }

      async function runBootstrapLoop(id: number) {
        while (running && id === cycleId) {
          setStatus('Your App asks SecretSpec for DATABASE_URL', 'var(--remote-app)');
          setActive(['app', 'core'], 'core-app', 'var(--remote-app)');
          if (!await travel({ route: 'core-app', from: 'app', label: 'DATABASE_URL?', color: 'var(--remote-app)', packet: 0, id })) return;
          if (!await delay(320, id)) return;

          setStatus('SecretSpec uses bootstrap to unlock onepassword', 'var(--remote-bootstrap)');
          setActive(['bootstrap', 'onepassword'], 'bootstrap-onepassword', 'var(--remote-bootstrap)');
          if (!await travel({ route: 'bootstrap-onepassword', from: 'bootstrap', label: 'service_account_token', color: 'var(--remote-bootstrap)', packet: 0, duration: 1050, id })) return;
          if (!await delay(360, id)) return;

          setStatus('onepassword returns DATABASE_URL to SecretSpec', 'var(--remote-onepassword)');
          setActive(['onepassword', 'core'], 'onepassword-core', 'var(--remote-onepassword)');
          if (!await travel({ route: 'onepassword-core', from: 'onepassword', label: 'DATABASE_URL', color: 'var(--remote-onepassword)', packet: 0, duration: 900, id })) return;
          if (!await delay(320, id)) return;

          setStatus('Your App receives DATABASE_URL, never the 1Password token', 'var(--remote-app)');
          setActive(['core', 'app'], 'core-app', 'var(--remote-app)');
          if (!await travel({ route: 'core-app', from: 'core', label: 'DATABASE_URL', color: 'var(--remote-app)', packet: 0, duration: 900, id })) return;
          nodes.forEach((node) => node.classList.remove('is-active'));
          routes.forEach((route) => route.classList.remove('is-active'));
          codeTokens.forEach((token) => token.classList.remove('is-active'));
          if (!await delay(1600, id)) return;
        }
      }

      function stop() {
      running = false;
      cycleId += 1;
      animations.forEach((animation) => animation.cancel());
      animations.clear();
      if (timerFrame !== undefined) window.cancelAnimationFrame(timerFrame);
      timerFrame = undefined;
      timerResolve?.(false);
      timerResolve = undefined;
      nodes.get('core')?.classList.remove('is-splitting');
      }

      function start() {
      if (running || reduceMotion || userPaused || !inView) return;
      running = true;
      cycleId += 1;
        if (kind === 'cache') void runCacheLoop(cycleId);
        else void runBootstrapLoop(cycleId);
      }

      drawRoutes();
      const resizeObserver = new ResizeObserver(drawRoutes);
      resizeObserver.observe(mapEl);

      motionButtonEl.addEventListener('click', () => {
      userPaused = !userPaused;
      motionButtonEl.classList.toggle('is-paused', userPaused);
      motionButtonEl.setAttribute('aria-label', userPaused ? 'Resume animation' : 'Pause animation');
      motionButtonEl.title = userPaused ? 'Resume animation' : 'Pause animation';
      if (userPaused) {
        stop();
        setStatus('Animation paused', 'var(--color-gray-400)');
      } else {
        start();
      }
      });

      if (reduceMotion) {
        motionButtonEl.hidden = true;
        if (kind === 'cache') {
          setFresh(true);
          updateTimer(6, 0.75);
          setStatus('Fresh DATABASE_URL reads come from local_cache', 'var(--remote-cache)');
          setActive(['cache', 'core', 'app']);
        } else {
          setStatus('bootstrap unlocks onepassword; Your App receives only DATABASE_URL', 'var(--remote-bootstrap)');
          setActive(['bootstrap', 'onepassword', 'core', 'app']);
        }
        return;
      }

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            inView = entry.isIntersecting;
            if (inView) start();
            else stop();
          });
        }, { threshold: 0.25 });
        observer.observe(demoEl);
      } else {
        inView = true;
        start();
      }
    });
  })();
</script>

